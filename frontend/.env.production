# Caminho relativo: front-end e API atrás do mesmo host:porta via Caddy
# (deploy/Caddyfile, MIGRACAO.md §1) — sem isso o build de produção tentaria
# falar com http://localhost:8000, que não existe fora da máquina de dev.
VITE_API_URL=/api

# Streamlit (admin) num subdomínio próprio, via HTTPS (ver deploy/Caddyfile).
# É o único endereço que o bundle embute: o VITE_API_URL é relativo de
# propósito, por isso trocar de domínio não exigiu rebuild por causa da API.
VITE_STREAMLIT_URL=https://admin.qualaconduta.com.br
