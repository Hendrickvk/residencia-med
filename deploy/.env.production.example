# Copie para .env.production (gitignorado) na raiz do projeto no servidor
# e preencha os valores reais. Nunca commitar o arquivo preenchido.

# Mesma connection string do .streamlit/secrets.toml (Neon/Postgres).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Obrigatório. Gere um valor novo, não reaproveite o de outro ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem isto a API sobe com um segredo aleatório por processo (e avisa no log):
# toda sessão aberta cai a cada restart. Até 2026-09-20 havia um default fixo no
# código — e este repositório é público, então qualquer pessoa podia assinar um
# cookie de sessão válido se esta variável faltasse aqui.
JWT_SECRET_KEY=

# Liga a flag Secure do cookie de sessão — só com HTTPS de pé. Produção
# serve em https://qualaconduta.com.br (deploy/Caddyfile), então true. Com
# HTTPS fora do ar, true quebra o login (o navegador não reenvia o cookie
# por http://): as duas coisas mudam juntas, nunca uma sem a outra.
COOKIE_SECURE=true

# E-mails com acesso administrativo (links do Acervo no app, e as ações
# destrutivas das telas do Streamlit). Lista separada por vírgula. Sem esta
# variável ninguém é admin, que é o lado seguro do erro — e é por isso que ela
# não tem mais valor padrão no código.
ADMIN_EMAILS=voce@exemplo.com

# Front-end e API ficam no mesmo host:porta em produção (ver
# deploy/Caddyfile), então isso é mais rede de segurança que necessidade —
# configure com o endereço real mesmo assim.
CORS_ORIGENS=https://qualaconduta.com.br

# Endereço público do front, usado para montar o link do e-mail de
# redefinição de senha. Sem isso o link sai apontando para localhost.
APP_URL=https://qualaconduta.com.br

# Envio do e-mail de "esqueci minha senha" (api/email.py, API HTTP do Brevo).
# Sem a chave, o endpoint continua respondendo 200 e o link vai para o log do
# servidor em vez do e-mail — o fluxo não quebra, mas ninguém recebe nada.
# O remetente precisa estar num domínio autenticado no Brevo (DKIM/DMARC) —
# desde 2026-09-22 é o `qualaconduta.com.br`. Sem isso o Brevo reescreve o
# `From:` para um endereço `@...brevosend.com`, porque freemail sem DKIM
# quebraria o DMARC de quem recebe.
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Conduta
