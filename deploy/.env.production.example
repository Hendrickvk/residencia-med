# Copie para .env.production (gitignorado) na raiz do projeto no servidor
# e preencha os valores reais. Nunca commitar o arquivo preenchido.

# Mesma connection string do .streamlit/secrets.toml (Neon/Postgres).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Gere um valor novo, não reaproveite o de outro ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Liga a flag Secure do cookie de sessão — só depois de HTTPS estar de pé.
# Publicação atual é por IP sem domínio (decisão de 2026-09-12), então SEM
# HTTPS automático (Let's Encrypt via Caddy exige domínio) — manter false
# até haver um domínio real (ver deploy/Caddyfile.com-dominio.example).
COOKIE_SECURE=false

# E-mails com acesso administrativo (edição/exclusão de questão e material,
# zona de risco). Lista separada por vírgula.
ADMIN_EMAILS=hendrickvk@gmail.com

# Front-end e API ficam no mesmo host:porta em produção (ver
# deploy/Caddyfile), então isso é mais rede de segurança que necessidade —
# configure com o endereço real mesmo assim (IP por ora, domínio depois).
CORS_ORIGENS=http://64.181.167.174
