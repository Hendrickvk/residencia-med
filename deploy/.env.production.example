# Copie para .env.production (gitignorado) na raiz do projeto no servidor
# e preencha os valores reais. Nunca commitar o arquivo preenchido.

# Mesma connection string do .streamlit/secrets.toml (Neon/Postgres).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Gere um valor novo, não reaproveite o de outro ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Liga a flag Secure do cookie de sessão — só com HTTPS de pé. Produção
# serve em https://conduta.duckdns.org (deploy/Caddyfile), então true. Com
# HTTPS fora do ar, true quebra o login (o navegador não reenvia o cookie
# por http://): as duas coisas mudam juntas, nunca uma sem a outra.
COOKIE_SECURE=true

# E-mails com acesso administrativo (links do Acervo no app). Lista separada
# por vírgula.
ADMIN_EMAILS=hendrickvk@gmail.com

# Front-end e API ficam no mesmo host:porta em produção (ver
# deploy/Caddyfile), então isso é mais rede de segurança que necessidade —
# configure com o endereço real mesmo assim.
CORS_ORIGENS=https://conduta.duckdns.org

# Endereço público do front, usado para montar o link do e-mail de
# redefinição de senha. Sem isso o link sai apontando para localhost.
APP_URL=https://conduta.duckdns.org

# Envio do e-mail de "esqueci minha senha" (api/email.py, API HTTP do Brevo).
# Sem a chave, o endpoint continua respondendo 200 e o link vai para o log do
# servidor em vez do e-mail — o fluxo não quebra, mas ninguém recebe nada.
# O remetente precisa estar verificado no Brevo (um e-mail basta, não exige
# domínio próprio).
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Conduta
