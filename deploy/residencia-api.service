[Unit]
Description=Residencia Med - API FastAPI
After=network.target

[Service]
Type=simple
User=residenciamed
WorkingDirectory=/var/www/residencia-med
EnvironmentFile=/var/www/residencia-med/.env.production
ExecStart=/var/www/residencia-med/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
